{
  "name": "psyche-atlas",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Psyche Atlas — a private, evidence-aware learner workspace for reflection, practice, and progress.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:api": "vitest run --config api/_vitest.config.ts",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run typecheck:api && npm run test && npm run test:api && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-pdf/renderer": "^4.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
