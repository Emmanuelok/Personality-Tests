# Public canonical origin used for Stripe success/cancel URLs. Production must
# use HTTPS and contain only the origin (no path, query, credentials, or hash).
APP_ORIGIN=https://example.com

# Optional external Ask Atlas provider. When unset, local development returns a
# truthful fallback signal. Preview/production return service_unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe server credentials. Keep these server-only in Vercel environment
# variables. Local development may leave all Stripe settings unset for demo mode;
# preview and production do not grant demo entitlements.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Independent random secrets, each at least 32 bytes. Rotate carefully: rotating
# these invalidates outstanding checkout snapshots or recovery tokens.
CHECKOUT_SIGNING_SECRET=
RECOVERY_TOKEN_SECRET=
RATE_LIMIT_SECRET=

# Production uses an allowlisted Stripe Price ID for every purchasable product.
# The matching cent value is checked against Stripe before Checkout is created.
STRIPE_PRICE_REPORT_ID=
STRIPE_PRICE_COGNITIVE_ID=
STRIPE_PRICE_ALLACCESS_ID=
STRIPE_PRICE_POSTER_ID=
PRICE_REPORT_CENTS=189
PRICE_COGNITIVE_CENTS=189
PRICE_ALLACCESS_CENTS=590
PRICE_POSTER_CENTS=290

# Vercel KV / Upstash Redis REST credentials. Required for durable production
# entitlement fulfillment, revocation, idempotency, norms, and rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
