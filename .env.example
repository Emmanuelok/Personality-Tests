# ─── Optional: LLM-backed "Ask Atlas" companion ───
# Set an Anthropic API key to let the in-app companion (/api/ask) answer freely in
# natural language. Without it, Atlas falls back to the built-in deterministic engine.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional model override (point at the latest Claude Opus for the richest answers).
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Stripe (server-side, set in Vercel → Project → Settings → Environment Variables) ───
# Leave unset to run in DEMO mode (the site works; "purchases" unlock instantly without charging).
# Set a real secret key to charge buyers via Stripe Checkout (no buyer login required).
STRIPE_SECRET_KEY=sk_test_xxx

# Optional price overrides, in cents. Defaults: report 189 ($1.89), all-access 590, poster 290.
PRICE_REPORT_CENTS=189
PRICE_ALLACCESS_CENTS=590
PRICE_POSTER_CENTS=290

# ─── Optional: bulletproof fulfillment ───
# Set a Stripe webhook (endpoint: /api/stripe-webhook) signing secret to record
# purchases server-side so they survive a closed tab and work across devices.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Provision Vercel KV (Storage tab) to persist entitlements; these are set for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
