# ─── Stripe (server-side, set in Vercel → Project → Settings → Environment Variables) ───
# Leave unset to run in DEMO mode (the site works; "purchases" unlock instantly without charging).
# Set a real secret key to charge buyers via Stripe Checkout (no buyer login required).
STRIPE_SECRET_KEY=sk_test_xxx

# Optional price overrides, in cents. Defaults: report 189 ($1.89), all-access 590, poster 290.
PRICE_REPORT_CENTS=189
PRICE_ALLACCESS_CENTS=590
PRICE_POSTER_CENTS=290
